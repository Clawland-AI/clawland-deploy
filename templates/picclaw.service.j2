[Unit]
Description=PicoClaw Edge Agent
Documentation=https://github.com/Clawland-AI/picclaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ picclaw_user }}
Group={{ picclaw_group }}
WorkingDirectory={{ picclaw_install_dir }}
ExecStart={{ picclaw_install_dir }}/picclaw --config {{ picclaw_config_dir }}/config.yaml
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ picclaw_data_dir }}

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=picclaw

[Install]
WantedBy=multi-user.target
