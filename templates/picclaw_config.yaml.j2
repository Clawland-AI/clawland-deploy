---
# PicoClaw Configuration Template
# Generated by Ansible

agent:
  name: {{ node_name }}
  type: picclaw
  version: {{ picclaw_version }}

server:
  port: {{ picclaw_port }}
  host: "0.0.0.0"
  
fleet:
  manager_url: {{ fleet_manager_url }}
  heartbeat_interval: 60s
  
telegram:
  enabled: {{ picclaw_enable_telegram | bool }}
{% if picclaw_telegram_token %}
  bot_token: {{ picclaw_telegram_token }}
{% endif %}

storage:
  data_dir: {{ picclaw_data_dir }}
  log_dir: {{ picclaw_data_dir }}/logs
  max_log_size_mb: 100

logging:
  level: info
  format: json
  output: file
